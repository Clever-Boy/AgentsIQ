# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# YAML files
*.yaml text eol=lf
*.yml text eol=lf

# Markdown files
*.md text eol=lf

# JSON files
*.json text eol=lf

# Configuration files
*.cfg text eol=lf
*.ini text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bat text eol=crlf

# Jupyter notebooks
*.ipynb text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.avi binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.whl binary

# Log files
*.log text eol=lf

# CSV files
*.csv text eol=lf

